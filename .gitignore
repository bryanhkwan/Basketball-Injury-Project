# Python and editor clutter
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Working files from the design and browser-testing tools
.taste-skill/
.playwright-cli/

# Downloads and caches: the NBA injury report PDFs, play-by-play files and saved web pages. The fetch steps rebuild
# them, and they are other people's data, so they are never republished here.
/data/

# Large intermediate files the analysis rebuilds
outputs/**/*.parquet
outputs/*.log

# Full per-player exports, kept local: the NBA dashboards' and the player profiles' (the site publishes copies in
# docs/data/), and the SCACCHoops listings (never published)
outputs/dashboard/
outputs/ncaa_injuries/
outputs/profiles/nba.json
outputs/profiles/college.json
outputs/aftermath/players.json

# The news research's list of injuries to look up (rebuilt by news-targets). Its findings, outputs/news/facts.jsonl,
# are kept; the quotes behind them stay in data/news/, which is never committed.
outputs/news/targets.jsonl

# Pages and stores of the earlier private dashboards; the public site is docs/
outputs/**/page.html
outputs/**/store/

# LinkedIn images, post drafts and the code that draws them, kept on this machine
outputs/linkedin/
src/injury_risk/linkedin.py
src/injury_risk/site/linkedin.css
tests/test_linkedin.py
